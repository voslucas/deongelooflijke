  "highlights": [
    {
      "start_seconds": 1260,
      "speaker": "Christophe Vekeman",
      "text": "Elke dag zijn eigen leed: de zin op het kerkaffiche die hem deed afstappen van zijn fiets.",
      "note": "Het begin van zijn bekering, een dubbelzinnige mix van pessimisme en troost."
    },
    {
      "start_seconds": 1620,
      "speaker": "Christophe Vekeman",
      "text": "Het schrijven van Tot God was voor mij een godservaring van meer doorslaggevende aard dan wat er in Oxford gebeurde.",
